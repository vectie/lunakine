import {
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/fs",
}

///|
struct Case {
  history : Array[Array[Double]]
  goals : Array[Double]
  libtorch_actions : Array[Double]
} derive(FromJson)

///|
struct Comparison {
  cases : Array[Case]
} derive(FromJson)

///|
fn ndarray(shape : Array[Int], values : Array[Double]) -> Json {
  let tuple = shape.map(x => x.to_string()).join(", ") + ","
  let header = "{'descr': '<f4', 'fortran_order': False, 'shape': (" + tuple + "), }"
  let padding = (64 - (10 + header.length() + 1) % 64) % 64
  let padded = header + Array::make(padding, " ").join("") + "\n"
  let b = @buffer.Buffer()
  b.write_bytes(b"\x93NUMPY\x01\x00"[:])
  b.write_uint16_le(padded.length().to_uint16())
  b.write_bytes(@utf8.encode(padded)[:])
  for value in values { b.write_float_le(Float::from_double(value)) }
  { "array": Json(@base64.encode(b.to_bytes()[:])), "polygraphy_class": "ndarray" }
}

///|
fn decode_array(value : Json) -> Array[Double] raise {
  let value = match value { { "values": inner, .. } => inner; _ => value }
  guard value is { "array": String(encoded), .. } else { fail("expected Polygraphy ndarray") }
  let bytes = @base64.decode(encoded)
  guard bytes.length() >= 10 && bytes[:8].to_owned() == b"\x93NUMPY\x01\x00" else {
    fail("expected NPY v1 output")
  }
  let start = 10 + bytes[8].to_int() + (bytes[9].to_int() << 8)
  guard start <= bytes.length() && (bytes.length() - start) % 4 == 0 else { fail("invalid FP32 output payload") }
  Array::makei((bytes.length() - start) / 4, i => {
    let p = start + i * 4
    Float::reinterpret_from_uint(bytes[p].to_uint() | (bytes[p+1].to_uint() << 8) |
      (bytes[p+2].to_uint() << 16) | (bytes[p+3].to_uint() << 24)).to_double()
  })
}

///|
async fn main {
  let args = @env.args()
  guard args.length() >= 4 else { fail("usage: verify_onnx.mbtx prepare COMPARISON INPUTS | check COMPARISON OUTPUTS REPORT") }
  let comparison : Comparison = @json.from_json(@json.parse(@utf8.decode(@fs.read_file(args[2]).binary())))
  if args[1] == "prepare" {
    let inputs : Array[Json] = comparison.cases.map(c => {
      let flat : Array[Double] = []
      for row in c.history { flat.append(row) }
      {
        "history": ndarray([1, c.history.length(), c.history[0].length()], flat),
        "goals": ndarray([1, c.goals.length()], c.goals),
      }
    })
    @fs.write_file(args[3], @utf8.encode(Json(inputs).stringify()), create_mode=CreateNew)
    println("prepared " + inputs.length().to_string() + " LibTorch comparison inputs")
    return
  }
  guard args[1] == "check" && args.length() == 5 else { fail("expected check COMPARISON OUTPUTS REPORT") }
  let outputs = @json.parse(@utf8.decode(@fs.read_file(args[3]).binary()))
  guard outputs is { "lst": [[String(_), Array(iterations)]], .. } &&
    iterations.length() == comparison.cases.length() else { fail("unexpected Polygraphy run result") }
  let mut maximum = 0.0
  for i, iteration in iterations {
    guard iteration is { "outputs": { "actions": value, .. }, .. } else { fail("missing actions") }
    let actual = decode_array(value)
    let expected = comparison.cases[i].libtorch_actions
    guard actual.length() == expected.length() else { fail("action count mismatch") }
    for j, y in actual {
      guard y == y && y - y == 0.0 else { fail("nonfinite ONNX action") }
      let error = (y - expected[j]).abs()
      if error > maximum { maximum = error }
    }
  }
  let report : Json = { "backend": "ONNX Runtime CPU", "cases": Json(iterations.length()),
    "max_absolute_error": Json(maximum), "tolerance": 0.0001, "passed": Json(maximum <= 0.0001) }
  @fs.write_file(args[4], @utf8.encode(report.stringify(indent=2)), create_mode=CreateNew)
  println(report.stringify())
  guard maximum <= 0.0001 else { fail("ONNX differs from LibTorch") }
}
